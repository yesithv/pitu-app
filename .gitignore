# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Código generado por build_runner (Drift). Se regenera en CI antes de
# analyze/test; no se versiona.
*.g.dart

# Localizaciones generadas por `flutter gen-l10n` (config en l10n.yaml). Se
# regeneran en `flutter pub get`/CI a partir de los ARB de lib/l10n; no se versionan.
/lib/l10n/app_localizations*.dart

# Lockfile de pub y registrant de plugins: los regenera Flutter en cada máquina/CI.
pubspec.lock
/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android: artefactos de build, config local y secretos de firma.
/android/.gradle/
/android/**/build/
/android/local.properties
/android/key.properties
*.jks
*.keystore
# El gradle-wrapper.jar es binario: no se versiona, se restaura en CI/local
# (ver docs/RELEASE_ANDROID.md y .github/workflows/android.yml).
/android/gradle/wrapper/gradle-wrapper.jar
# Iconos del launcher por defecto: se restauran del andamiaje hasta generar los
# definitivos con flutter_launcher_icons.
/android/app/src/main/res/mipmap-*/
